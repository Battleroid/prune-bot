# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Paths inside the container; defaults are fine for the shipped compose file
PRUNE_CONFIG_PATH=/config/config.toml
PRUNE_DB_PATH=/data/prune.db

LOG_LEVEL=INFO

# Emergency brake: 1 = sweep loop never starts, regardless of config.
# Requires a container restart to clear.
PRUNE_PANIC=0
